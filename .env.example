# Copiar a .env y completar. En desarrollo y test, DEVISE_JWT_SECRET_KEY cae por
# defecto a Rails.application.secret_key_base si no está seteada.

# Clave secreta para firmar los JWT. Generar con: rails secret
# En producción es obligatoria, una distinta por entorno (ADR-021).
DEVISE_JWT_SECRET_KEY=

# Password del rol de PostgreSQL en desarrollo.
PROYECTO_API_DATABASE_PASSWORD=admin

# Claves para el cifrado at-rest de credenciales de integraciones (AES-256-GCM).
# Generar cada una con: rails secret. En dev/test caen a secret_key_base.
ENCRYPTION_KEY=
ENCRYPTION_KEY_DERIVATION_SALT=

# URL pública HTTPS de esta API, sin barra final: con ella se registran los
# webhooks en los proveedores. En desarrollo, la de un túnel, por ejemplo
# `ngrok http 3000` → https://xxxx.ngrok-free.app
PUBLIC_WEBHOOK_BASE_URL=

# --- Integraciones reales en desarrollo --------------------------------------
# Las leen las tareas `bin/rails "integrations:<proveedor>:connect[slug]"`
# (lib/tasks/integrations.rake y lib/tasks/oca.rake). Una tanda por empresa:
# <SLUG> es el slug en mayúsculas.

# Shopify (ADR-018): la app propia de la empresa en el Dev Dashboard.
# SHOPIFY_NORTE_SHOP_DOMAIN=onestock-norte.myshopify.com
# SHOPIFY_NORTE_CLIENT_ID=
# SHOPIFY_NORTE_CLIENT_SECRET=

# OCA e-Pak (ADR-022). Estos valores son los de la cuenta de PRUEBA PÚBLICA que
# OCA publica para desarrolladores (developers.oca.com.ar/epak.html): no son
# secretos y sólo funcionan contra su entorno de prueba (ocadev). El centro de
# costo sale de GetCentroCostoPorOperativa(CUIT, Operativa). Los seeds ya conectan
# a Norte con esta cuenta en desarrollo: sólo hace falta descomentarlas para usar
# otra cuenta con `integrations:oca:connect`.
# OCA_NORTE_USR=test@oca.com.ar
# OCA_NORTE_PSW=123456
# OCA_NORTE_CUIT=30-53625919-4
# OCA_NORTE_NROCUENTA=111757/001
# OCA_NORTE_OPERATIVA=64665
# OCA_NORTE_CENTROCOSTO=1
# Opcionales: franja horaria del retiro (1, 2 o 3; por defecto 1) y email de
# contacto del retiro.
# OCA_NORTE_IDFRANJAHORARIA=1
# OCA_NORTE_EMAIL=

# --- Sólo producción (ADR-021) ----------------------------------------------
# Sin DEVISE_JWT_SECRET_KEY, CORS_ALLOWED_ORIGINS ni RAILS_ALLOWED_HOSTS la API
# no arranca en producción. En desarrollo no hacen falta.

# Orígenes del front, separados por comas. `*` vale para un nivel de subdominio
# (el de cada empresa). Sin la variable, fuera de producción: localhost.
# CORS_ALLOWED_ORIGINS=https://*.precision-logistics.duckdns.org

# Hosts a los que responde la API, separados por comas.
# RAILS_ALLOWED_HOSTS=api.precision-logistics.duckdns.org

# Contraseñas de las cuentas que crea db:seed (el entrypoint del Dockerfile lo
# corre sobre toda base nueva). En producción son obligatorias para sembrar y
# no pueden ser las de desarrollo que trae el repo.
# SEED_USER_PASSWORD=
# SEED_ADMIN_PASSWORD=
