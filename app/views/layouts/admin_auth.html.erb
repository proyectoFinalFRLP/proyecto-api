<!DOCTYPE html>
<html lang="es">
<head>
  <title>Backoffice — Proyecto API</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <style>
    * { box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; margin: 0; min-height: 100vh; display: flex;
           align-items: center; justify-content: center; background: #111827; color: #1f2937; }
    .card { background: #fff; border-radius: 8px; padding: 2rem; width: 100%; max-width: 22rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35); }
    h1 { font-size: 1.15rem; margin: 0 0 1.25rem; text-align: center; }
    .field { margin-bottom: 0.9rem; }
    .field label { display: block; font-weight: 600; margin-bottom: 0.25rem; font-size: 0.9rem; }
    .field input[type="email"], .field input[type="password"] { width: 100%; padding: 0.5rem;
            border: 1px solid #d1d5db; border-radius: 4px; }
    .remember { display: flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; }
    .btn { width: 100%; background: #2563eb; color: #fff; padding: 0.55rem; border: 0;
           border-radius: 4px; font-weight: 600; cursor: pointer; margin-top: 0.5rem; }
    .alert { background: #fef2f2; border: 1px solid #dc2626; color: #991b1b; padding: 0.6rem 0.9rem;
             border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Backoffice — Proyecto API</h1>
    <% if alert %><div class="alert"><%= alert %></div><% end %>
    <% if notice %><div class="alert" style="background:#f0fdf4;border-color:#16a34a;color:#166534;"><%= notice %></div><% end %>
    <%= yield %>
  </div>
</body>
</html>
